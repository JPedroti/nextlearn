# Copie este arquivo para .env (que NÃO vai para o Git) e preencha.
# Todos os valores abaixo são falsos/exemplos.

# Chave secreta do Django. Em produção, o Render gera uma automaticamente.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# True só no seu computador. Em produção, sempre False.
DEBUG=True

# Endereços aceitos, separados por vírgula. O endereço do Render é adicionado sozinho.
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe vazio para usar SQLite local. Em produção: connection string do Neon.
DATABASE_URL=
# Exemplo de formato: postgresql://usuario:senha@ep-exemplo-123.sa-east-1.aws.neon.tech/nextlearn?sslmode=require

# --- Provedor de IA ----------------------------------------------------------
# Escolha um: "gemini" (Google AI Studio) ou "openai" (qualquer API compatível com a da OpenAI).
# Sem chave, o app funciona inteiro, mas o botão "Gerar com IA" fica desligado (com aviso na tela).

# Opção A: Gemini (padrão). Cole a sua chave depois do "=".
IA_PROVEDOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opção B: compatível com a OpenAI (DeepSeek, Groq, OpenAI etc.)
# IA_PROVEDOR=openai
# IA_API_KEY=sua-chave-falsa-aqui
# IA_BASE_URL=https://api.deepseek.com/v1
# IA_MODEL=deepseek-chat

# Opcional (só no Render): cria o primeiro usuário administrador durante o build.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@exemplo.com
# DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
# DJANGO_SUPERUSER_PAPEL=professor
